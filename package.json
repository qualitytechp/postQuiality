  "build": {
    "appId": "com.qualitytech.pos",
    "productName": "QualityTech POS",
    "icon": "assets/icon-512.png",
    "afterPack": "scripts/afterPack.js",
    "asar": true,
    "asarUnpack": "**/node_modules/better-sqlite3/**/*",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!**/better-sqlite3/build/Release/test_extension.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "qualitytechp",
      "repo": "postQuiality",
      "releaseType": "release",
      "channel": "latest"
    },
    "detectUpdateChannel": false,
    "generateUpdatesFilesForAllChannels": true,
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "frontend/out",
        "to": "frontend-out"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "qualitytech-pos-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "entitlements": "build/entitlements.plist",
      "entitlementsInherit": "build/entitlements.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "qualitytech-pos-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "synopsis": "Self-hosted Point of Sale for cafes and restaurants",
      "description": "Flo is a free, open-source point-of-sale system for cafes, restaurants, and small kitchens. Local-first, offline-capable, no cloud lock-in, no per-seat fees.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets",
      "category": "Office",
      "executableName": "flocafe",
      "artifactName": "qualitytech-pos-${version}-linux.${ext}",
      "extraFiles": [
        {
          "from": "assets/com.qualitytech.pos.metainfo.xml",
          "to": "usr/share/metainfo/com.qualitytech.pos.metainfo.xml"
        },
        {
          "from": "assets/icons",
          "to": "usr/share/icons"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Flo Cafe",
          "Comment": "Free, open-source POS for cafes and restaurants",
          "GenericName": "Point of Sale",
          "Keywords": "pos;point of sale;restaurant;cafe;billing;invoice;",
          "StartupWMClass": "flo-desktop"
        }
      }
    },
    "appImage": {
      "artifactName": "qualitytech-pos-${version}-linux.appimage"
    },
    "snapcraft": {
      "base": "core24",
      "core24": {
        "confinement": "strict",
        "useLXD": true,
        "extensions": [
          "gnome"
        ],
        "stagePackages": [
          "default"
        ],
        "plugs": [
          "default",
          "browser-support",
          "cups-control",
          "avahi-observe",
          "avahi-control",
          "raw-usb",
          "removable-media",
          "network-bind",
          "screen-inhibit-control"
        ],
        "environment": {
          "TMPDIR": "$XDG_RUNTIME_DIR"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.5": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qualitytechp/postQuiality.git"
  }
